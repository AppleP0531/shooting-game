                + draw(g: Graphics): void
                + reload(): void
                + getItemConfig(): Map<ItemKinds, ItemConfig>
                + getItemImage(): Map<ItemKinds, BufferedImage[]>
                + addItem(item: Item): void
                + removeItem(item: Item): void
                + clearItems(): void
                + getItemList(): List<Item>
            }

            enum ItemKinds {
