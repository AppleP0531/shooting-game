                + draw(g: Graphics): void
                + move(dt: double): void
                + {abstract} effect(): void
                + destroySelf(): void
                + getCollisionSize(): double
                + getPos(): Vector2
            }

            class ItemFactory {
                - {static} random: Random
                - {static} DROP_TABLE: Map<Collectible, Integer>
                --
                + {static} createItem(pos: Vector2): Item
                + {static} createItem(pos: Vector2, kind: Collectible): Item
