    package "subship" {
        package "module" {
            enum ModuleStat {
                ATK_PCT
                ATK_FLAT
                DEF_PCT
                DEF_FLAT
                SHIELD_PCT
                SHIELD_FLAT
                REPAIR_PCT
                HP_PCT
                HP_FLAT
                HEAL_PCT
                HEAL_FLAT
            }
            enum ModuleKind {
                ATC
                DEF
                SHIELD
                REPAIR
                HP
                HEAL
            }
            class Module <<lombok @Data>> {
                - id: long
                - kind: ModuleKind
                - rarity: Rarity
                - mainValue: double
                - subs: List<Sub>
            }
            class ModuleInventory <<lombok @Data>> {
                - nextId: long
                - owned: List<Module>
                - slots: List<Long>
            }
            class ModuleService <<Utility>> {
                + {static} owned(): List<Module>
                + {static} slotted(): Module[]
                + {static} stat(stat: ModuleStat): double
                + {static} equip(id: long): boolean
                + {static} unequip(id: long): void
                + {static} recipe(kind: ModuleKind, rarity: Rarity): Cost
                + {static} craft(kind: ModuleKind, rarity: Rarity): Module
                + {static} addNew(kind: ModuleKind, rarity: Rarity): Module
                + {static} dismantleRefund(rarity: Rarity): int
                + {static} roll(kind: ModuleKind, rarity: Rarity): Module
                + {static} dismantle(id: long): boolean
            }
            Module --> ModuleKind
            Module --> ModuleStat
            ModuleInventory o-- Module
            ModuleService ..> ModuleInventory
        }

        class UnitService <<Utility>> {
            + {static} MAX_LEVEL: int
            + {static} MAX_STARS: int
            --
            + {static} getLevel(shipId: String): int
            + {static} getStars(shipId: String): int
            + {static} getCopies(shipId: String): int
            + {static} attackRate(shipId: String): double
            + {static} hpRate(shipId: String): double
            + {static} baseHp(shipId: String): double
            + {static} levelCost(level: int): Cost
            + {static} levelUp(shipId: String): boolean
            + {static} addCopy(shipId: String): void
            + {static} buyCopy(shipId: String): boolean
            + {static} copyPrice(shipId: String): int
            + {static} starUp(shipId: String): boolean
            + {static} starText(shipId: String): String
        }

        class DamageCalculator <<Utility>> {
            + {static} bulletAttackRate(): double
            + {static} beamAttackRate(): double
            + {static} colorRate(attackMode: ColorMode, target: Ship): double
            + {static} bulletToEnemy(bullet: Bullet, target: Ship): double
            + {static} beamToEnemy(dps: double, tick: double, mode: ColorMode, bossRate: double, target: Ship): double
            + {static} defenseRate(): double
            + {static} toPlayer(raw: double): double
            + {static} ramToPlayer(p: Player): double
        }
        DamageCalculator ..> UnitService
        DamageCalculator ..> SkillService
        DamageCalculator ..> ModuleService

