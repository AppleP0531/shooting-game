        interface CommandAction <<functional>> {
            ~ execute(node: CommandNode, args: String[]): void
        }

        enum MoveOption {
            ONE_LINE_UP
            ONE_LINE_DOWN
            ONE_PAGE_UP
            ONE_PAGE_DOWN
        }

        class CommandNode <<Lomboc @Data>> {
            - name: String
            - description: String
            - adminOnly: boolean
            - action: CommandAction
            - parent: CommandNode
            - subCommands: Map<String, CommandNode>
            - syntax: List<String>
            --
            + CommandNode(parent: CommandNode, name: String, description: String, adminOnly: boolean, action: CommandAction)
