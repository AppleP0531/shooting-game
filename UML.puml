        }

        class SelectStageSceneUI {
            --
            + SelectStageSceneUI()
            + draw(g: Graphics): void
        }

        class StarRewardPanel {
            - {static} UPCOMING: int <<未達成の表示数>>
            - onChanged: Runnable <<受け取り後にボタン表記を更新>>
            - summaryLabel: JLabel
            - messageLabel: JLabel
