@startuml game

skinparam style strictuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

package "shooting_game" {
    class ShootingGameMain <<Singleton>> {
        - {static} instance: ShootingGameMain
        - {static} glassPane: CommandGlassPane
        - cardLayout: CardLayout
        - loadStat: String
        - lastScene: SceneType
        - {static} screenSizeAdj: double
        - fps: int
        - gameThread: Thread
        - loaded: boolean
        - running: boolean
        --
        - ShootingGameMain()
        + {static} getInstance(): ShootingGameMain
        + {static} setup(args: String[]): void
        - start(): void
        + run(): void
        - update(dt: double): void
        + paintComponent(g: Graphics): void
        + getScreenSizeAdj(): double
        + setFps(fps: int): void
    }

    class SceneManager <<Singleton>> {
        - {static} instance: SceneManager
