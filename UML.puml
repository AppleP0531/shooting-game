                --
                + NormalStageSceneUI()
                + draw(g: Graphics, scroll: double): void <<紺の宇宙に、スクロールで流れる星(層ごとに速さが違う)と、上の帯(SceneBars)を描く>>
            }

            class Star <<record>> {
                ~ x: double
                ~ y: double
                ~ layer: int
                ~ size: double
                ~ phase: double
            }

            NormalStageSceneUI +-- Star

            class Chapters <<Utility>> {
                + {static} STAGES_PER_CHAPTER: int = 20
                + {static} BOSS_INTERVAL: int = 5
                - {static} NAMES: String[] <<星座の名前(12)>>
                - Chapters()
                + {static} chapterOf(stageId: int): int
                + {static} isChapterEnd(stageId: int): boolean
                + {static} isBoss(stageId: int): boolean
                + {static} name(chapter: int): String
                + {static} label(chapter: int): String
            }

            package "subPanels" {
                class StageBtnPanel {
                    - {static} component: String
                    - stageDetailPanel: StageDetailPanel
                    - MAIN: ShootingGameMain
                    - NSM: NormalStageManager
                    - STAGE_M: StageManager
                    - {static} NODE_H: double = 64
                    - {static} NODE_W: double = 56
                    - lockImage: BufferedImage
                    - panelSize: Vector2
                    - originPos: Vector2
                    - scrollOffset: double
                    - maxScrollOffset: double
                    - buttonMap: Map<Integer, JButton>
                    --
                    + StageBtnPanel()
                    - createStageButton(stageId: int, image: BufferedImage, locked: boolean): JButton <<画像がなければ StageNodeIcon.create(台の絵と★)、ロック中は鍵を重ねる>>
                    - lockIconImage(buttonSize: int): BufferedImage
                    + initComponents(): void
                    + setup(): void
                    + reload(): void
                    - loadImages(): void
                    - drawPanel(): void
                    - drawBtn(): void
                    - buttonCenter(data: StageBtnData): Vector2 <<台の中心(PLATFORM_CENTER の分だけ下)>>
                    + getScrollOffset(): double <<背景の星を流すのに使う>>
                    # paintComponent(g: Graphics): void <<台を点線の経路でつなぎ、章の最後に「第N章」と星座名のラベルを出す>>
                }

                class StageInfoView {
                    - viewWidth: int
                    - highScore: int
                    - rewards: List<Reward>
