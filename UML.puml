        + {static} getInstance(): SceneManager
        + setup(): void
        + update(dt: double): void
        + draw(g: Graphics): void
        + changeScene(target: SceneType): void
        + changeToPreviousScene(): void
        - getCurrentManager(): Manager
        + getSceneName(): SceneType
    }

    enum SceneType {
        TITLE
        LOBBY
        BAG
        UPGRADE
        SHOP
        SELECTSTAGE
        NORMALSTAGE
        INFINITYSTAGE
        SETTING
        GAME
        GAMERESULT
        TEST
    }

    class CommandGlassPane {
        - MAIN: ShootingGameMain
        - SM: SceneManager
        - RM: ResourceManager
        - NSM: NormalStageManager
        - GM: GameManager
        - IM: ItemManager
        - SHIP_M: ShipManager
        - BM: BulletManager
        - STAGE_M: StageManager
        - rootCommands: Map<String, CommandNode>
        - commandField: JTextField
        - commandHistory: List<String>
        - historyIndex: int
        - MAX_HISTORY: int
        - currentInput: String
        - historyList: JList<String>
        - MAX_HISTORY_DISPLAY: int
        - historyDiff: int
        - historyModel: DefaultListModel<String>
        - adminMode: boolean
        --
        + CommandGlassPane(onEnter: Runnable)
        - moveHistory(diff: int): void
        + executeCommand(): void
        + showCommandBar(): void
        + hideCommandBar(): void
        - showHistoryList(diff: int): void
        - hideHistoryList(): void
        - processCommand(text: String): void
        - register(name: String, desc: String, admin: boolean, action: CommandAction): CommandNode
        - isSceneValid(allowedTypes: SceneType...): boolean
        - registCommands(): void
        - showHelp(): void
        - tryParse(value: String): Integer
        - reload(): void
        - unknownCommand(text: String): void
