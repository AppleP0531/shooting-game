                + addBullet(bullet: Bullet): void
                + clearBullets(): void
                + removeBullet(bullet: Bullet): void
                + getBulletConfig(): Map<ShipKinds, Map<BulletKinds, Map<Integer, BulletConfig>>>
                + getBulletImage(): Map<ShipKinds, Map<BulletKinds, Map<Integer, BufferedImage[]>>>
                + getBulletList(): List<Bullet>
            }

            enum BulletKinds {
                STRAIGHT
                TRACKING
                LASER
                BALL
            }

            class BulletConfig <<lomboc @Data>> {
                - imagePath: String
                - grids: Vector2
                - useCount: int
                - frameRate: double
                - imageSize: int
                - collisionSize: double
                - speed: double
                - damage: double
                - cooldowns: Map<String, Double>
            }

            abstract class Bullet {
                # MAIN: ShootingGameMain
                # BM: BulletManager
                # GM: GameManager
                # SHIP_M: ShipManager
                # pos: Vector2
                # speed: double
                # collisionSize: double
                # vec: double
                # damage: double
                # lifeTime: double
                # lifeTimer: double
                # alpha: float
                # owner: ShipKinds
                # kind: BulletKinds
                # bulletImages: BufferedImage[]
                # currentFrame: int
                # frameTimer: double
                # frameRate: double
                --
                + Bullet(owner: ShipKinds, kind: BulletKinds, id: int, pos: Vector2, vec: double)
                + move(dt: double): void
                + update(dt: double): void
                + draw(g: Graphics): void
                + inScreen(): boolean
                + isLife(): boolean
                + destroySelf(): void
                + inScreen(): boolean
                + isLife(): boolean
                + destroySelf(): void
                + getPos(): Vector2
                + getCollisionSize(): double
                + getDamage(): damage
                + getOwner(): ShipKinds
            }

            class BulletFactory {
                + {static} createBullet(owner: ShipKinds, kind: BulletKinds, pos: Vector2, vec: double): Bullet
            }

            package "types" {
                class Tracking {
                    - maxSpeed: double
                    - target: Ship
                    - TURNING_SMOOTHNESS: double
                    --
                    + Tracking(owner ShipKinds, id: int, pos Vector2, vec double)
                    + update(dt: double): void
                    + draw(g: Graphics): void
                    - speedAdj(dt: double): void
                    - vecAdj(dt: double): void
                    - setTarget(): Ship
                }

                class Straight {
                    + Straight(owner ShipKinds, id: int, pos Vector2, vec double)
                    + draw(g: Graphics): void
                }

                class Laser {
                    + Laser(owner ShipKinds, id: int, pos Vector2, vec double)
                    + draw(g: Graphics): void
                }

                class Ball {
                    + Ball(owner ShipKinds, id: int, pos Vector2, vec double)
                    + draw(g: Graphics): void
                }
            }
        }

        package "item" {
