@startuml game

skinparam style strictuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

package "shooting_game" {
    class ShootingGameMain <<Singleton>> {
        - {static} instance: ShootingGameMain
        - {static} glassPane: CommandGlassPane
        - cardLayout: CardLayout
        - lastScene: SceneType
        - {static} screenSizeAdj: double
        - fps: int <<GameSettings.getFps()>>
        - gameThread: Thread
        - loaded: boolean
        - running: boolean
        --
        - ShootingGameMain()
        + {static} getInstance(): ShootingGameMain
        + {static} setup(args: String[]): void
        - start(): void
        + run(): void
        - {static} waitUntil(targetNanos: long): void
        - {static} keepTimerResolution(): void
        - update(dt: double): void
        + paintComponent(g: Graphics): void
        + getScreenSizeAdj(): double
        + setFps(fps: int): void
        + getFps(): int
    }

    class SceneManager <<Singleton>> {
        - {static} instance: SceneManager
        - scenes: Map<SceneType, Manager>
        - prevScenes: List<SceneType>
        - sceneName: SceneType
        --
        - SceneManager()
        + {static} getInstance(): SceneManager
        + setup(): void
        + update(dt: double): void
        + draw(g: Graphics): void <<最後に CoinHud.draw を呼ぶ>>
        + changeScene(target: SceneType): void
        + changeToPrevScene(): void
        + getCurrentManager(): Manager
        + getSceneName(): SceneType
    }

    enum SceneType {
        TITLE
        LOBBY
        BAG
        UPGRADE
        SHOP
        ENCYCLOPEDIA
        SELECTSTAGE
        NORMALSTAGE
        INFINITYSTAGE
        EXTRA_MODULE
        EXTRA_BOSS
        EXTRA_MATERIAL
        EXTRA_SPECIAL
        SETTING
        GAME
        GAMERESULT
        TEST
    }

    package "command"{
        class CommandGlassPane {
            - {static} component: String
            - MAIN: ShootingGameMain
            - SM: SceneManager
            - RM: ResourceManager
            - NSM: NormalStageManager
            - UM: UpgradeManager
            - IM: ItemManager
            - SHIP_M: ShipManager
            - BM: BulletManager
            - STAGE_M: StageManager
            - mouseHandler: MouseAdapter
            - keyHandler: KeyAdapter
            - adminMode: boolean
            ~ rootCommands: Map<String, CommandNode>
            - commandField: JTextField
            - spacing: double
            - COMMAND_INPUT_HISTORY: List<String>
            - INPUT_HISTORY_MODEL: DefaultListModel<String>
            - INPUT_HISTORY_LIST: JList<String>
            - MAX_INPUT_HISTORY: int
            - MAX_INPUT_HISTORY_DISPLAY: int
            - currentInput: String
            - inputHistoryIndex: int
            - inputHistoryDiff: int
            - inputHistoryData: ChatBoxContext<String>
            - COMMAND_LOG_HISTORY: List<LogLine>
            - LOG_HISTORY_MODEL: DefaultListModel<LogLine>
            - LOG_HISTORY_LIST: JList<LogLine>
            - MAX_LOG_HISTORY: int
            - DEFAULT_LOG_HISTORY_DISPLAY: int
            - MAX_LOG_HISTORY_DISPLAY: int
            - logHistoryIndex: int
            - logHistoryDiff: int
            - logHistoryData: ChatBoxContext<LogLine>
            - {static} CLOSED_LOG_MAX_LINES: int
            - {static} CLOSED_LOG_VISIBLE_MS: long
            - {static} CLOSED_LOG_FADE_MS: long
            - recentLogTimer: Timer
            - chatOpacity: float
            - COMMAND_SUGGEST: List<String>
            - SUGGEST_MODEL: DefaultListModel<String>
            - SUGGEST_LIST: JList<String>
            - MAX_SUGGEST: int
            - MAX_SUGGEST_DISPLAY: int
            - suggestIndex: int
            - suggestDiff: int
            - suggestData: ChatBoxContext<String>
            - isAutoComplete: boolean
            - suggestions: List<Suggestion>
            - argCandidates: Map<String, Supplier<List<String>>>
            --
            + CommandGlassPane(onEnter: Runnable)
            - moveHistory(context: ChatBoxContext<?>, diff: MoveOption): void
            + showCommandBar(text: String): void
            + hideCommandBar(): void
            - showChatBoxList(context: ChatBoxContext<T>): void
            - hideChatBoxList(context: ChatBoxContext<?>): void
            ~ addLog(kind: LogLine.Kind, text: String): void
            - showRecentLog(): void <<入力欄を閉じたあと新しい行だけ薄く消えながら表示>>
            - placeLogList(): void
            - chatUserName(): String
            - hideAllChatBox(): void
            - initFadeTimer(): void
            + executeCommand(): void
            - processCommand(text: String): void
            - findCommand(nodes: Map<String, CommandNode>, token: String): CommandNode
            - registArgCandidates(): void
            - addSuggestion(display: String, completion: String, matchEnd: int): void
            - cycleSuggestion(dir: int): void
            - registCommandSuggestions(): void
            - registCommands(): void
            ~ showHelp(): void
            ~ reload(): void
            ~ unknownCommand(text: String): void
            - addHandler(): void
            - removeHandler(): void
            + setAdminMode(enabled: boolean): void
            ~ isAdminMode(): boolean
        }

        interface CommandAction <<functional>> {
            ~ execute(node: CommandNode, args: String[]): void
        }

        enum MoveOption {
            ONE_LINE_UP
            ONE_LINE_DOWN
            ONE_PAGE_UP
            ONE_PAGE_DOWN
        }

        class CommandNode <<Lomboc @Data>> {
            - name: String
            - description: String
            - adminOnly: boolean
            - action: CommandAction
            - parent: CommandNode
            - subCommands: Map<String, CommandNode>
            - syntax: List<String>
            --
            + CommandNode(parent: CommandNode, name: String, description: String, adminOnly: boolean, action: CommandAction)
            + getUseage(): String
            - getFullPath(): String
            + getAllNodes(adminMode: boolean): List<String>
            + compersionSyntax(token: String): boolean
        }

        class ChatBoxContext<T> <<lombok @Data>> {
            - elements: List<T>
            - model: DefaultListModel<T>
            - list: JList<T>
            - maxSavelength: int
            - maxDisplay: int
            - index: int
            - diff: int
            --
            + addElement(element: T): void
        }

        class LogLine <<record>> {
            ~ text: String
            ~ kind: Kind
            ~ createdAt: long <<エポックミリ秒>>
            --
            ~ LogLine(text: String, kind: Kind)
        }

        enum Kind {
            INFO
            SUCCESS
            ERROR
            HELP
            CHAT
        }

        class LogCellRenderer <<CommandGlassPane内部>> {
            - line: LogLine
            - background: Color
            --
            + getListCellRendererComponent(list: JList, value: LogLine, index: int, ...): Component
            - prefixOf(kind: LogLine.Kind, font: Font): String
            - colorOf(kind: LogLine.Kind): Color
            - fadeOf(target: LogLine): float
            # paintComponent(g: Graphics): void
        }

        abstract class CommandGroup {
            # {static} component: String
            # pane: CommandGlassPane
            # rootCommands: Map<String, CommandNode>
            # logText: String
            --
            ~ CommandGroup(pane: CommandGlassPane)
            ~ {abstract} registerAll(): void
            # info(text: String): void
            # success(text: String): void
            # error(text: String): void
            # usage(node: CommandNode): void
            # register(root: Map<String,CommandNode>, name: String, desc: String, admin: boolean, action: CommandAction): CommandNode
            # register(root: CommandNode, name: String, desc: String, admin: boolean, action: CommandAction): CommandNode
            # isSceneValid(allowedTypes: SceneType...): boolean
            # parseNBT(arg: String): Map<String, String>
        }

        class SystemCommands <<Commands>> {
            ~ registerAll(): void
        }

        class GameCommands <<Commands>> {
            ~ registerAll(): void
        }

        class PlayerDataCommands <<Commands>> {
            ~ registerAll(): void
        }

        CommandGroup <|-- SystemCommands
        CommandGroup <|-- GameCommands
        CommandGroup <|-- PlayerDataCommands
        CommandGroup --> CommandGlassPane
        CommandGlassPane ..> CommandGroup
        LogLine --> Kind
        ChatBoxContext o-- LogLine
        CommandGlassPane ..> LogLine
        CommandGroup ..> LogLine
    }

    class ResourceManager <<Singleton>> {
        - {static} component: String
        - {static} instance: ResourceManager
        - resourceConfigMap: Map<ResourceName, ResourceConfig>
        - resourceImageCache: Map<ResourceName, Map<Rarity, BufferedImage[]>>
        - resourceViewCache: Map<ResourceName, Map<Rarity, BufferedImage[]>>
        --
        - ResourceManager()
        + {static} getInstance(): ResourceManager
        - loadConfig(): void
        - loadImages(): void
        + setup(): void
        + update(dt: double): void
        + draw(g: Graphics): void 
        + reload(): void
        + getResourceConfig(): Map<ResourceName, ResourceConfig>
        + getResourceImage(): Map<ResourceName, Map<Rarity, BufferedImage[]>>
        + getResourceView(): Map<ResourceName, Map<Rarity, BufferedImage[]>>
    }

    class ResourceConfig <<Lomboc @Data>> {
        - id: int
        - rarity: Map<Rarity, Map<ImageType, ResourceData>>
    }

    class ResourceData <<Lomboc @Data>> {
        - imagePath: String
        - grids: Vector2
        - useCount: int
        - frameRate: double
        - imageSize: int
        - viewGrids: Vector2
        - viewUseCount: int
        - viewFrameRate: double
    }

    class ResourceKinds {
        + {static} COIN: ResourceKinds
        - resName: ResourceName
        - rarity: Rarity
        --
        + ResourceKinds(key: String)
        + getResourceKind(): ResourceKinds
    }

    enum ResourceName {
        GEAR : 強化素材
        SCREW : 強化素材
        COPPER_PLATE : パーツ素材
        IRON_BAR : パーツ素材
        COIN
        FRAME
        ENERGY_CELL : 強化素材
        CIRCUIT : 強化素材
        LENS : 強化素材
        ALLOY_PLATE : パーツ素材
        CRYSTAL_SHARD : パーツ素材
        PLASMA_CORE : パーツ素材
        --
        - family: Family
        - displayName: String
        + getFamily(): Family
        + getDisplayName(): String
        + fromString(value: String): ResourceName
    }

    enum Family {
        UPGRADE : スキル強化用
        PART : サブ機パーツ制作用
        NONE
    }

    enum Rarity {
        COMMON
        UNCOMMON
        RARE
        EPIC
        LEGENDARY
        --
        + fromString(value: String): Rarity
    }

    enum ImageType {
        ITEM
        VIEW
    }

